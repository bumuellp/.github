{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Central Renovate configuration preset for bumuellp repositories",
  "extends": [
    "config:best-practices",
    ":semanticCommits",
    ":dependencyDashboard"
  ],
  "assigneesFromCodeOwners": true,
  "reviewersFromCodeOwners": true,
  "timezone": "Europe/Berlin",
  "schedule": [
    "before 6am on monday"
  ],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "minimumReleaseAge": "3 days",
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": [],
    "dependencyDashboardApproval": false,
    "minimumReleaseAge": null
  },
  "osvVulnerabilityAlerts": true,
  "dependencyDashboardOSVVulnerabilitySummary": "all",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ],
    "automerge": false
  },
  "docker-compose": {
    "managerFilePatterns": [
      "/(^|/)(docker-)?compose.*\\.ya?ml(\\.tftpl)?$/",
      "/(^|/)compose.*\\.ya?ml(\\.tftpl)?$/"
    ]
  },
  "customDatasources": {
    "github-api-versions": {
      "defaultRegistryUrlTemplate": "https://api.github.com/versions",
      "format": "json",
      "transformTemplates": [
        "{\"releases\": [$.{\"version\": $}]}"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Automatically track Docker images inside OpenTofu .tftpl compose files",
      "managerFilePatterns": [
        "/(^|/)docker-compose.*\\.ya?ml\\.tftpl$/"
      ],
      "matchStrings": [
        "image:\\s*(?<depName>[a-zA-Z0-9_-]+/[a-zA-Z0-9_-]+):(?<currentValue>[^\\s\"']+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Automatically track GitHub release asset download URLs in any YAML config",
      "managerFilePatterns": [
        "/(^|/)config/.*\\.ya?ml$/",
        "/(^|/).*\\.ya?ml$/"
      ],
      "matchStrings": [
        "https://github\\.com/(?<depName>[^/]+/[^/]+)/releases/download/(?<currentValue>[^/]+)/(?<assetName>[^\\s\"']+)"
      ],
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)\\.tofu-version$/"],
      "matchStrings": ["(?<currentValue>[0-9.]+)"],
      "depNameTemplate": "opentofu/opentofu",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Track GitHub REST API calendar versions via .github-api-version",
      "managerFilePatterns": ["/(^|/)\\.github-api-version$/"],
      "matchStrings": ["^\\s*(?<currentValue>\\d{4}-\\d{2}-\\d{2})\\s*$"],
      "datasourceTemplate": "custom.github-api-versions",
      "depNameTemplate": "github-rest-api",
      "versioningTemplate": "regex:^(?<major>\\d{4})-(?<minor>\\d{2})-(?<patch>\\d{2})$"
    }
  ],
  "packageRules": [
    {
      "description": "Do not automerge GitHub REST API breaking calendar version upgrades",
      "matchPackageNames": ["github-rest-api"],
      "automerge": false,
      "labels": ["api-breaking-change"]
    },
    {
      "description": "Group pre-commit hooks into a single weekly bundle",
      "matchManagers": ["pre-commit"],
      "groupName": "pre-commit hooks",
      "semanticCommitType": "chore",
      "semanticCommitScope": "pre-commit"
    },
    {
      "description": "Group and pin GitHub Actions by full SHA for security",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "semanticCommitType": "ci",
      "semanticCommitScope": "actions",
      "pinDigests": true
    },
    {
      "description": "Group linter and formatter updates together",
      "matchPackageNames": [
        "ruff",
        "astral-sh/ruff-pre-commit",
        "prettier",
        "pre-commit/mirrors-prettier",
        "markdownlint-cli2",
        "DavidAnson/markdownlint-cli2",
        "scanaislop/aislop",
        "python-jsonschema/check-jsonschema"
      ],
      "groupName": "linters and formatters",
      "semanticCommitType": "chore",
      "semanticCommitScope": "lint"
    },
    {
      "description": "Python dependency management (uv / pyproject.toml)",
      "matchManagers": ["pep621", "uv"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "python-deps"
    },
    {
      "description": "Docker container base images and packages",
      "matchManagers": ["dockerfile"],
      "semanticCommitType": "build",
      "semanticCommitScope": "docker"
    },
    {
      "description": "Node.js and npm ecosystem",
      "matchManagers": ["npm"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps"
    }
  ]
}
