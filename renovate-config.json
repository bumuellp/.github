{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Central Renovate preset for bumuellp repos (config:best-practices includes dependencyDashboard, digest pinning, devDep pinning, configMigration, and abandonments; :semanticCommits forces Conventional Commits)",
  "extends": [
    "config:best-practices",
    "customManagers:dockerfileVersions",
    ":enablePreCommit",
    ":semanticCommits"
  ],
  "assigneesFromCodeOwners": true,
  "reviewersFromCodeOwners": true,
  "timezone": "Europe/Berlin",
  "schedule": [
    "before 6am on monday"
  ],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "prCreation": "not-pending",
  "platformAutomerge": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": [],
    "dependencyDashboardApproval": false,
    "minimumReleaseAge": null
  },
  "osvVulnerabilityAlerts": true,
  "dependencyDashboardOSVVulnerabilitySummary": "all",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ],
    "automerge": false
  },
  "customDatasources": {
    "github-api-versions": {
      "defaultRegistryUrlTemplate": "https://api.github.com/versions",
      "format": "json",
      "transformTemplates": [
        "{\"releases\": [$.{\"version\": $}]}"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Automatically track Docker images inside OpenTofu .tftpl compose files",
      "managerFilePatterns": [
        "/(^|/)(?:docker-)?compose.*\\.ya?ml\\.tftpl$/"
      ],
      "matchStrings": [
        "image:[ \\t]*[\"']?(?<depName>[a-z0-9./_-]+?):(?<currentValue>[^\\s\"'@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?[\"']?"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Track dependencies annotated with # renovate: comments in YAML files",
      "managerFilePatterns": ["/(^|/).*\\.ya?ml$/"],
      "matchStrings": [
        "(?:^|\\n)[ \\t]*[a-zA-Z0-9_.-]+:[ \\t]*[\"']?(?:[a-z0-9./_-]+:)?(?<currentValue>[^\\s\"'@#]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?[\"']?[ \\t]*#[ \\t]*renovate:[ \\t]*datasource=(?<datasource>[a-zA-Z0-9-._]+)[ \\t]+depName=(?<depName>[^\\s#]+)(?:[ \\t]+versioning=(?<versioning>[^\\s#]+))?",
        "(?:^|\\n)[ \\t]*#[ \\t]*renovate:[ \\t]*datasource=(?<datasource>[a-zA-Z0-9-._]+)[ \\t]+depName=(?<depName>[^\\s#]+)(?:[ \\t]+versioning=(?<versioning>[^\\s#]+))?[ \\t]*\\n[ \\t]*[a-zA-Z0-9_.-]+:[ \\t]*[\"']?(?:[a-z0-9./_-]+:)?(?<currentValue>[^\\s\"'@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?[\"']?"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Track OpenTofu version in .tofu-version files",
      "managerFilePatterns": ["/(^|/)\\.tofu-version$/"],
      "matchStrings": ["^v?(?<currentValue>[0-9.]+)\\s*$"],
      "depNameTemplate": "opentofu/opentofu",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Track GitHub REST API calendar versions via .github-api-version",
      "managerFilePatterns": ["/(^|/)\\.github-api-version$/"],
      "matchStrings": ["^\\s*(?<currentValue>\\d{4}-\\d{2}-\\d{2})\\s*$"],
      "datasourceTemplate": "custom.github-api-versions",
      "depNameTemplate": "github-rest-api",
      "versioningTemplate": "regex:^(?<major>\\d{4})-(?<minor>\\d{2})-(?<patch>\\d{2})$"
    }
  ],
  "packageRules": [
    {
      "description": "Skip minimumReleaseAge cooldown for trusted bumuellp repositories, actions, hooks, and container images",
      "matchPackageNames": [
        "/^bumuellp\\//",
        "/^ghcr\\.io\\/bumuellp\\//",
        "/^https:\\/\\/github\\.com\\/bumuellp\\//"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "pre-commit hook management",
      "matchManagers": ["pre-commit"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "pre-commit"
    },
    {
      "description": "Group and automerge non-major pre-commit hook updates",
      "matchManagers": ["pre-commit"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "pre-commit hooks",
      "automerge": true
    },
    {
      "description": "GitHub Actions management (SHA pinning provided by config:best-practices)",
      "matchManagers": ["github-actions"],
      "semanticCommitType": "ci",
      "semanticCommitScope": "actions"
    },
    {
      "description": "Group and automerge non-major GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "github-actions",
      "automerge": true
    },
    {
      "description": "Python dependency management (uv / pyproject.toml)",
      "matchManagers": ["pep621", "poetry", "uv"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "python-deps"
    },
    {
      "description": "Group and automerge non-major Python dependency updates",
      "matchManagers": ["pep621", "poetry", "uv"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "python dependencies",
      "automerge": true
    },
    {
      "description": "mise toolchain management",
      "matchManagers": ["mise"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "tools"
    },
    {
      "description": "Group and automerge non-major mise tool updates",
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "mise tools",
      "automerge": true
    },
    {
      "description": "Docker container base images and compose services",
      "matchManagers": ["dockerfile", "docker-compose"],
      "semanticCommitType": "build",
      "semanticCommitScope": "docker"
    },
    {
      "description": "Group and automerge non-major and digest Docker updates into a single bundle",
      "matchManagers": ["dockerfile", "docker-compose"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "pinDigest"],
      "groupName": "docker images",
      "automerge": true
    },
    {
      "description": "Keep Python minor runtime tag upgrades separate from weekly Docker digest bundle",
      "matchManagers": ["dockerfile", "docker-compose"],
      "matchPackageNames": ["python"],
      "matchUpdateTypes": ["minor"],
      "groupName": null
    },
    {
      "description": "Node.js and npm ecosystem",
      "matchManagers": ["npm"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Group and automerge non-major npm dependency updates",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "npm dependencies",
      "automerge": true
    },
    {
      "description": "Group major npm devDependency updates into a single bundle",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["major"],
      "groupName": "npm devDependencies"
    },
    {
      "description": "Rust and Cargo ecosystem",
      "matchManagers": ["cargo"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "rust-deps"
    },
    {
      "description": "Group and automerge non-breaking Rust crate updates",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "matchJsonata": ["$not(isBreaking = true)"],
      "groupName": "rust dependencies",
      "groupSlug": "rust-dependencies",
      "automerge": true
    },
    {
      "description": "Group breaking Rust crate upgrades sharing an upstream repository unless already in a monorepo group",
      "matchManagers": ["cargo"],
      "matchSourceUrls": ["/^https?:\\/\\/[^/]+\\/[^/]+\\/[^/]+/"],
      "matchJsonata": [
        "isBreaking = true and ($not($exists(groupName)) or groupName = null or groupName = \"\")"
      ],
      "groupName": "rust {{{sourceRepo}}}",
      "groupSlug": "rust-{{{sourceRepoSlug}}}",
      "separateMajorMinor": false,
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "description": "Automerge non-major updates detected via custom regex managers",
      "matchManagers": ["custom.regex"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "Require dashboard approval and disable automerge for GitHub REST API breaking calendar version upgrades",
      "matchPackageNames": ["github-rest-api"],
      "automerge": false,
      "dependencyDashboardApproval": true,
      "minimumReleaseAge": null,
      "labels": ["api-breaking-change"]
    },
    {
      "description": "Require Dependency Dashboard approval and disable automerge for major updates",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "dependencyDashboardApproval": true
    }
  ]
}
